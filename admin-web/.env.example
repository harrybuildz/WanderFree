# admin-web — the console UI. Everything here is bundled into the JS and is
# therefore PUBLIC. Only the anon key belongs in this file; the service-role
# key lives in admin-api/.env and never leaves that process.

VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=
VITE_ADMIN_API_URL=http://localhost:4000
