# admin-api — internal admin console server.
#
# This process holds the SERVICE ROLE key, which bypasses Row Level Security
# entirely. Keep this file local (it is gitignored) and never copy these values
# into admin-web/ — anything the browser can read is public.

# Supabase project URL (same one the mobile app uses).
SUPABASE_URL=https://<project-ref>.supabase.co

# Service role / secret key — Supabase dashboard > Project Settings > API.
# NOT the anon key. This is what makes catalog writes possible at all.
SUPABASE_SERVICE_ROLE_KEY=

# Anon key, used only to verify incoming user JWTs.
SUPABASE_ANON_KEY=

# Where admin-web runs, for CORS. Comma-separated for multiple origins.
ALLOWED_ORIGINS=http://localhost:5173

PORT=4000
